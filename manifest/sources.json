{
  // Every source this toolchain is built from. `minimal-android-ndk pin --platform <tag>`
  // fills in the commits: the AOSP repositories are resolved through the
  // release manifest, which states a commit for each project, and the rest
  // are resolved against their own remotes.
  //
  // A platform tag is not a revision. android-14.0.0_r75 exists in the
  // platform manifest and not in platform/ndk, so nothing here is ever
  // checked out by tag.
  "platform": "",
  "target": {
    "triple": "aarch64-linux-android",
    "arch": "arm64",
    "abi": "arm64-v8a",
    "api": 27
  },
  "sources": [
    {
      "name": "bionic",
      "url": "https://android.googlesource.com/platform/bionic",
      "project": "platform/bionic",
      "commit": "",
      "paths": ["libc", "libm", "libdl"],
      "note": "libc, libm and libdl: the public headers, the kernel uapi headers and the symbol maps"
    },
    {
      "name": "native",
      "url": "https://android.googlesource.com/platform/frameworks/native",
      "project": "platform/frameworks/native",
      "commit": "",
      "paths": ["include", "libs", "opengl"],
      "note": "EGL, GLES, nativewindow and the android/ headers"
    },
    {
      "name": "base",
      "url": "https://android.googlesource.com/platform/frameworks/base",
      "project": "platform/frameworks/base",
      "commit": "",
      "paths": ["core/res", "native/android"],
      "note": "core/res is the framework resource package; native/android carries libandroid"
    },
    {
      "name": "av",
      "url": "https://android.googlesource.com/platform/frameworks/av",
      "project": "platform/frameworks/av",
      "commit": "",
      "paths": ["media/libaaudio"],
      "note": "AAudio headers and symbol map"
    },
    {
      "name": "wilhelm",
      "url": "https://android.googlesource.com/platform/frameworks/wilhelm",
      "project": "platform/frameworks/wilhelm",
      "commit": "",
      "paths": ["include", "src"],
      "note": "OpenSL ES headers and symbol map"
    },
    {
      "name": "nativehelper",
      "url": "https://android.googlesource.com/platform/libnativehelper",
      "project": "platform/libnativehelper",
      "commit": "",
      "paths": ["include_jni"],
      "note": "jni.h, which android/input.h and everything else that hands a Java object to native code includes"
    },
    {
      "name": "logging",
      "url": "https://android.googlesource.com/platform/system/logging",
      "project": "platform/system/logging",
      "commit": "",
      "paths": ["liblog"],
      "note": "liblog"
    },
    {
      "name": "ndk",
      "url": "https://android.googlesource.com/platform/ndk",
      "commit": "",
      "paths": ["meta", "sources"],
      "note": "meta/platforms.json for the API map, and the native app glue the application links. Not part of a platform release: the NDK is built from its own manifest branch, so a platform tag does not name a revision for it. Set ref to pin it to something other than the head of its default branch"
    },
    {
      "name": "soong",
      "url": "https://android.googlesource.com/platform/build/soong",
      "project": "platform/build/soong",
      "commit": "",
      "paths": ["cc", "android"],
      "note": "ndkstubgen, and the future API level a preview codename resolves to"
    },
    {
      "name": "apksig",
      "url": "https://android.googlesource.com/platform/tools/apksig",
      "project": "platform/tools/apksig",
      "commit": "",
      "note": "the signer, built with javac and jar"
    },
    {
      "name": "llvm-project",
      "url": "https://github.com/llvm/llvm-project",
      "ref": "refs/tags/llvmorg-22.1.8",
      "commit": "",
      "paths": ["cmake", "runtimes", "compiler-rt", "libcxx", "libcxxabi", "libunwind", "libc", "third-party", "llvm/cmake", "llvm/utils"],
      "note": "compiler-rt builtins and the C++ runtimes. Set ref to the llvmorg-* tag matching the host clang; a checkout that is not complete shows up as libc++ missing llvm-libc shared headers"
    },
    {
      "name": "r8",
      "url": "https://r8.googlesource.com/r8",
      "ref": "refs/tags/agp-9.2.1",
      "commit": "",
      "optional": true,
      "note": "only needed when the document picker bridge is compiled to DEX"
    }
  ],
  "headers": [
    {
      "source": "bionic",
      "find": "libc/include",
      "into": "",
      "note": "bionic has no libm/include: the math headers are here too, next to the rest",
      "require": ["stdio.h", "stdlib.h", "string.h", "pthread.h", "dlfcn.h",
                  "math.h", "fenv.h", "complex.h"]
    },
    {
      "source": "bionic",
      "find": "libc/kernel/uapi",
      "into": "",
      "exclude": ["asm-arm", "asm-arm64", "asm-riscv", "asm-x86"],
      "require": ["linux/types.h"]
    },
    {
      "source": "bionic",
      "note": "bionic keeps two uapi trees: the scrubbed kernel headers, and Android's own additions beside them. linux/stddef.h is in the first and the linux/compiler_types.h it includes is in the second, so a sysroot with only one of them compiles nothing that reaches for stddef",
      "find": "libc/kernel/android/uapi",
      "into": "",
      "require": ["linux/compiler_types.h", "linux/compiler.h"]
    },
    {
      "source": "bionic",
      "find": "libc/kernel/uapi/asm-arm64/asm",
      "into": "asm",
      "require": ["asm/types.h"]
    },
    {
      "source": "nativehelper",
      "find": "include_jni",
      "require": ["jni.h"]
    },
    {
      // First of the android/ rules, because a header that is already there
      // is kept and the rest are ignored: log.h lives with liblog, and the
      // one the framework checkouts carry declares less of it.
      "source": "logging",
      "find": "liblog/include/android",
      "into": "android",
      "require": ["android/log.h"]
    },
    {
      "source": "native",
      "find": "include/android",
      "into": "android",
      "all": true,
      "require": ["android/native_window.h", "android/input.h", "android/keycodes.h", "android/rect.h"]
    },
    {
      "source": "base",
      "find": "include/android",
      "into": "android",
      "all": true,
      "require": ["android/native_activity.h", "android/asset_manager.h", "android/looper.h", "android/configuration.h"]
    },
    {
      "source": "native",
      "find": "opengl/include/KHR",
      "into": "KHR",
      "require": ["KHR/khrplatform.h"]
    },
    {
      "source": "native",
      "find": "opengl/include/EGL",
      "into": "EGL",
      "require": ["EGL/egl.h", "EGL/eglext.h"]
    },
    {
      "source": "native",
      "find": "opengl/include/GLES",
      "into": "GLES",
      "require": ["GLES/gl.h", "GLES/glext.h"]
    },
    {
      "source": "native",
      "find": "opengl/include/GLES2",
      "into": "GLES2",
      "require": ["GLES2/gl2.h"]
    },
    {
      "source": "native",
      "find": "opengl/include/GLES3",
      "into": "GLES3",
      "require": ["GLES3/gl3.h"]
    },
    {
      "source": "wilhelm",
      "find": "include/SLES",
      "optional": true,
      "into": "SLES",
      "require": ["SLES/OpenSLES.h", "SLES/OpenSLES_Android.h"]
    },
    {
      "source": "av",
      "find": "include/aaudio",
      "optional": true,
      "into": "aaudio",
      "require": ["aaudio/AAudio.h"]
    }
  ],
  "stubs": [
    {
      "library": "c",
      "source": "bionic",
      "file": "libc.map.txt",
      "verify": ["malloc", "free", "pthread_create", "openat"]
    },
    {
      "library": "m",
      "source": "bionic",
      "file": "libm.map.txt",
      "verify": ["sqrt", "fmod"]
    },
    {
      "library": "dl",
      "source": "bionic",
      "file": "libdl.map.txt",
      "verify": ["dlopen", "dlsym"]
    },
    {
      "library": "log",
      "source": "logging",
      "file": "liblog.map.txt",
      "verify": ["__android_log_write", "__android_log_print", "__android_log_vprint"]
    },
    {
      "library": "android",
      "source": ["base", "native"],
      "file": "libandroid.map.txt",
      "verify": ["AAssetManager_open", "ALooper_wake", "ANativeActivity_showSoftInput"]
    },
    {
      "library": "nativewindow",
      "source": "native",
      "file": "libnativewindow.map.txt",
      "verify": ["ANativeWindow_setBuffersTransform", "ANativeWindow_setBuffersGeometry"]
    },
    {
      "library": "EGL",
      "source": "native",
      "file": "libEGL.map.txt",
      "verify": ["eglCreateWindowSurface", "eglSwapBuffers", "eglQuerySurface"]
    },
    {
      "library": "GLESv2",
      "source": "native",
      "file": "libGLESv2.map.txt",
      "verify": ["glDrawArrays", "glTexImage2D"]
    },
    {
      "library": "GLESv3",
      "source": "native",
      "file": "libGLESv3.map.txt",
      "verify": ["glMapBufferRange"]
    },
    {
      "library": "aaudio",
      "optional": true,
      "source": "av",
      "file": "libaaudio.map.txt",
      "verify": ["AAudio_createStreamBuilder"]
    },
    {
      "library": "OpenSLES",
      "optional": true,
      "source": "wilhelm",
      "file": "libOpenSLES.map.txt",
      "verify": ["slCreateEngine"]
    }
  ]
}
