{
  // Every source this toolchain is built from. `minimal-android-ndk pin --platform <tag>`
  // fills in the commits: the AOSP repositories are resolved through the
  // release manifest, which states a commit for each project, and the rest
  // are resolved against their own remotes.
  //
  // A platform tag is not a revision. android-14.0.0_r75 exists in the
  // platform manifest and not in platform/ndk, so nothing here is ever
  // checked out by tag.
  "platform": "",
  "target": {
    "triple": "aarch64-linux-android",
    "arch": "arm64",
    "abi": "arm64-v8a",
    "api": 27
  },
  "sources": [
    {
      "name": "bionic",
      "url": "https://android.googlesource.com/platform/bionic",
      "project": "platform/bionic",
      "commit": "",
      "paths": ["libc", "libm", "libdl"],
      "note": "libc, libm and libdl: the public headers, the kernel uapi headers and the symbol maps"
    },
    {
      "name": "native",
      "url": "https://android.googlesource.com/platform/frameworks/native",
      "project": "platform/frameworks/native",
      "commit": "",
      "paths": ["include", "libs", "opengl"],
      "note": "EGL, GLES, nativewindow and the android/ headers"
    },
    {
      "name": "base",
      "url": "https://android.googlesource.com/platform/frameworks/base",
      "project": "platform/frameworks/base",
      "commit": "",
      "paths": ["core/res", "native/android"],
      "note": "core/res is the framework resource package; native/android carries libandroid"
    },
    {
      "name": "av",
      "url": "https://android.googlesource.com/platform/frameworks/av",
      "project": "platform/frameworks/av",
      "commit": "",
      "paths": ["media/libaaudio"],
      "note": "AAudio headers and symbol map"
    },
    {
      "name": "wilhelm",
      "url": "https://android.googlesource.com/platform/frameworks/wilhelm",
      "project": "platform/frameworks/wilhelm",
      "commit": "",
      "paths": ["include", "src"],
      "note": "OpenSL ES headers and symbol map"
    },
    {
      "name": "logging",
      "url": "https://android.googlesource.com/platform/system/logging",
      "project": "platform/system/logging",
      "commit": "",
      "paths": ["liblog"],
      "note": "liblog"
    },
    {
      "name": "ndk",
      "url": "https://android.googlesource.com/platform/ndk",
      "project": "platform/ndk",
      "commit": "",
      "paths": ["meta", "sources"],
      "note": "meta/platforms.json for the API map, and the native app glue the application links"
    },
    {
      "name": "soong",
      "url": "https://android.googlesource.com/platform/build/soong",
      "project": "platform/build/soong",
      "commit": "",
      "paths": ["cc", "android"],
      "note": "ndkstubgen, and the future API level a preview codename resolves to"
    },
    {
      "name": "apksig",
      "url": "https://android.googlesource.com/platform/tools/apksig",
      "project": "platform/tools/apksig",
      "commit": "",
      "note": "the signer, built with javac and jar"
    },
    {
      "name": "llvm-project",
      "url": "https://github.com/llvm/llvm-project",
      "ref": "refs/heads/main",
      "commit": "",
      "paths": ["cmake", "runtimes", "compiler-rt", "libcxx", "libcxxabi", "libunwind", "libc", "third-party", "llvm/cmake", "llvm/utils"],
      "note": "compiler-rt builtins and the C++ runtimes. Set ref to the llvmorg-* tag matching the host clang; a checkout that is not complete shows up as libc++ missing llvm-libc shared headers"
    },
    {
      "name": "skia",
      "url": "https://skia.googlesource.com/skia",
      "ref": "refs/heads/main",
      "commit": "",
      "note": "Ganesh for GLES. Set ref to the milestone branch that is being tracked"
    },
    {
      "name": "zlib",
      "url": "https://github.com/madler/zlib",
      "ref": "refs/tags/v1.3.1",
      "commit": "",
      "note": "built here rather than taken from Skia's third_party: that copy is Chromium's, and its zconf.h includes a chromeconf.h which is not part of zlib"
    },
    {
      "name": "libpng",
      "url": "https://github.com/pnggroup/libpng",
      "ref": "refs/tags/v1.6.44",
      "commit": ""
    },
    {
      "name": "libjpeg-turbo",
      "url": "https://github.com/libjpeg-turbo/libjpeg-turbo",
      "ref": "refs/tags/3.0.4",
      "commit": ""
    },
    {
      "name": "libwebp",
      "url": "https://chromium.googlesource.com/webm/libwebp",
      "ref": "refs/tags/v1.4.0",
      "commit": ""
    },
    {
      "name": "freetype",
      "url": "https://gitlab.freedesktop.org/freetype/freetype.git",
      "ref": "refs/tags/VER-2-13-3",
      "commit": ""
    },
    {
      "name": "libzip",
      "url": "https://github.com/nih-at/libzip",
      "ref": "refs/tags/v1.11.2",
      "commit": ""
    },
    {
      "name": "ogg",
      "url": "https://github.com/xiph/ogg",
      "ref": "refs/tags/v1.3.5",
      "commit": ""
    },
    {
      "name": "vorbis",
      "url": "https://github.com/xiph/vorbis",
      "ref": "refs/tags/v1.3.7",
      "commit": ""
    },
    {
      "name": "flac",
      "url": "https://github.com/xiph/flac",
      "ref": "refs/tags/1.4.3",
      "commit": ""
    },
    {
      "name": "opus",
      "url": "https://github.com/xiph/opus",
      "ref": "refs/tags/v1.5.2",
      "commit": ""
    },
    {
      "name": "libsndfile",
      "url": "https://github.com/libsndfile/libsndfile",
      "ref": "refs/tags/1.2.2",
      "commit": ""
    },
    {
      "name": "xz",
      "url": "https://github.com/tukaani-project/xz",
      "ref": "refs/tags/v5.6.3",
      "commit": ""
    },
    {
      "name": "oboe",
      "url": "https://github.com/google/oboe",
      "ref": "refs/tags/1.9.0",
      "commit": "",
      "note": "OpenAL Soft's Android backend. A mismatched revision shows up as namespace errors around flowgraph"
    },
    {
      "name": "openal-soft",
      "url": "https://github.com/kcat/openal-soft",
      "ref": "refs/tags/1.23.1",
      "commit": ""
    },
    {
      "name": "r8",
      "url": "https://r8.googlesource.com/r8",
      "ref": "refs/heads/main",
      "commit": "",
      "note": "only needed when the document picker bridge is compiled to DEX"
    }
  ],
  // Every one of these is a static library with position-independent code,
  // and none of them builds its own executables, tests, examples or
  // benchmarks: an executable needs the Android CRT startup objects, and this
  // link sysroot deliberately does not have them.
  "packages": [
    {
      "name": "zlib",
      "options": ["-DZLIB_BUILD_EXAMPLES=OFF"],
      "produces": ["lib/libz.a", "include/zlib.h", "lib/pkgconfig/zlib.pc"]
    },
    {
      "name": "libpng",
      "needs": ["zlib"],
      "options": ["-DPNG_SHARED=OFF", "-DPNG_STATIC=ON", "-DPNG_TESTS=OFF",
                  "-DPNG_TOOLS=OFF", "-DPNG_FRAMEWORK=OFF"],
      "produces": ["lib/libpng16.a", "lib/pkgconfig/libpng.pc"]
    },
    {
      "name": "libjpeg-turbo",
      "options": ["-DENABLE_SHARED=OFF", "-DENABLE_STATIC=ON",
                  "-DWITH_JAVA=OFF", "-DWITH_TURBOJPEG=ON"],
      "produces": ["lib/libjpeg.a", "lib/pkgconfig/libjpeg.pc"]
    },
    {
      "name": "libwebp",
      "options": ["-DWEBP_BUILD_ANIM_UTILS=OFF", "-DWEBP_BUILD_CWEBP=OFF",
                  "-DWEBP_BUILD_DWEBP=OFF", "-DWEBP_BUILD_GIF2WEBP=OFF",
                  "-DWEBP_BUILD_IMG2WEBP=OFF", "-DWEBP_BUILD_VWEBP=OFF",
                  "-DWEBP_BUILD_WEBPINFO=OFF", "-DWEBP_BUILD_WEBPMUX=OFF",
                  "-DWEBP_BUILD_EXTRAS=OFF"],
      "produces": ["lib/libwebp.a", "lib/pkgconfig/libwebp.pc"]
    },
    {
      "name": "freetype",
      "needs": ["zlib", "libpng"],
      "options": ["-DFT_DISABLE_HARFBUZZ=ON", "-DFT_DISABLE_BROTLI=ON",
                  "-DFT_DISABLE_BZIP2=ON", "-DFT_REQUIRE_ZLIB=ON",
                  "-DFT_REQUIRE_PNG=ON"],
      "produces": ["lib/libfreetype.a", "lib/pkgconfig/freetype2.pc"],
      "note": "harfbuzz is off in Skia too, so it is not built for the target either"
    },
    {
      "name": "libzip",
      "needs": ["zlib"],
      "options": ["-DBUILD_TOOLS=OFF", "-DBUILD_REGRESS=OFF",
                  "-DBUILD_EXAMPLES=OFF", "-DBUILD_DOC=OFF",
                  "-DENABLE_COMMONCRYPTO=OFF", "-DENABLE_GNUTLS=OFF",
                  "-DENABLE_MBEDTLS=OFF", "-DENABLE_OPENSSL=OFF",
                  "-DENABLE_BZIP2=OFF", "-DENABLE_LZMA=OFF",
                  "-DENABLE_ZSTD=OFF", "-DHAVE_SYS_ATTR_H=0"],
      "produces": ["lib/libzip.a", "lib/pkgconfig/libzip.pc"],
      "note": "HAVE_SYS_ATTR_H is seeded because libzip must not select the Darwin source on Android"
    },
    {
      "name": "xz",
      "options": ["-DXZ_TOOL_XZ=OFF", "-DXZ_TOOL_XZDEC=OFF",
                  "-DXZ_TOOL_LZMADEC=OFF", "-DXZ_TOOL_LZMAINFO=OFF",
                  "-DXZ_TOOL_SCRIPTS=OFF", "-DXZ_DOC=OFF"],
      "produces": ["lib/liblzma.a", "lib/pkgconfig/liblzma.pc"],
      "note": "only the library: xz, xzdec, lzmadec and lzmainfo are executables"
    },
    {
      "name": "ogg",
      "produces": ["lib/libogg.a", "lib/pkgconfig/ogg.pc"]
    },
    {
      "name": "vorbis",
      "needs": ["ogg"],
      "produces": ["lib/libvorbis.a", "lib/libvorbisenc.a"]
    },
    {
      "name": "flac",
      "needs": ["ogg"],
      "options": ["-DBUILD_PROGRAMS=OFF", "-DBUILD_EXAMPLES=OFF",
                  "-DBUILD_DOCS=OFF", "-DBUILD_CXXLIBS=OFF",
                  "-DINSTALL_MANPAGES=OFF", "-DWITH_FORTIFY_SOURCE=OFF"],
      "produces": ["lib/libFLAC.a"],
      "note": "the microbenchmarks and the programs are executables"
    },
    {
      "name": "opus",
      "options": ["-DOPUS_BUILD_PROGRAMS=OFF", "-DOPUS_BUILD_TESTING=OFF"],
      "produces": ["lib/libopus.a", "lib/pkgconfig/opus.pc"]
    },
    {
      "name": "libsndfile",
      "needs": ["ogg", "vorbis", "flac", "opus"],
      "options": ["-DBUILD_PROGRAMS=OFF", "-DBUILD_EXAMPLES=OFF",
                  "-DENABLE_EXTERNAL_LIBS=ON", "-DENABLE_MPEG=OFF",
                  "-DENABLE_CPACK=OFF"],
      "produces": ["lib/libsndfile.a", "lib/pkgconfig/sndfile.pc"]
    },
    {
      "name": "oboe",
      "options": ["-DBUILD_TESTING=OFF"],
      "produces": ["lib/liboboe.a"]
    },
    {
      "name": "openal-soft",
      "needs": ["oboe"],
      "options": ["-DLIBTYPE=STATIC", "-DALSOFT_EXAMPLES=OFF",
                  "-DALSOFT_UTILS=OFF", "-DALSOFT_TESTS=OFF",
                  "-DALSOFT_INSTALL_EXAMPLES=OFF", "-DALSOFT_INSTALL_UTILS=OFF",
                  "-DALSOFT_BACKEND_OBOE=ON", "-DALSOFT_BACKEND_OPENSL=ON",
                  "-DALSOFT_BACKEND_ALSA=OFF", "-DALSOFT_BACKEND_PULSEAUDIO=OFF",
                  "-DALSOFT_BACKEND_PIPEWIRE=OFF"],
      "produces": ["lib/libopenal.a", "lib/pkgconfig/openal.pc"],
      "note": "Oboe compiles its OpenSL ES fallback at API 27, so both backends need their headers and stubs"
    }
  ],
  "headers": [
    {
      "source": "bionic",
      "find": "libc/include",
      "into": "",
      "require": ["stdio.h", "stdlib.h", "string.h", "pthread.h", "dlfcn.h"]
    },
    {
      "source": "bionic",
      "find": "libc/kernel/uapi",
      "into": "",
      "exclude": ["asm-arm", "asm-arm64", "asm-riscv", "asm-x86"],
      "require": ["linux/types.h"]
    },
    {
      "source": "bionic",
      "find": "libc/kernel/uapi/asm-arm64/asm",
      "into": "asm",
      "require": ["asm/types.h"]
    },
    {
      "source": "bionic",
      "find": "libm/include",
      "into": "",
      "require": ["math.h"]
    },
    {
      "source": "native",
      "find": "include/android",
      "into": "android",
      "all": true,
      "require": ["android/native_window.h", "android/input.h", "android/keycodes.h", "android/rect.h"]
    },
    {
      "source": "base",
      "find": "include/android",
      "into": "android",
      "all": true,
      "require": ["android/native_activity.h", "android/asset_manager.h", "android/looper.h", "android/configuration.h"]
    },
    {
      "source": "native",
      "find": "opengl/include/KHR",
      "into": "KHR",
      "require": ["KHR/khrplatform.h"]
    },
    {
      "source": "native",
      "find": "opengl/include/EGL",
      "into": "EGL",
      "require": ["EGL/egl.h", "EGL/eglext.h"]
    },
    {
      "source": "native",
      "find": "opengl/include/GLES2",
      "into": "GLES2",
      "require": ["GLES2/gl2.h"]
    },
    {
      "source": "native",
      "find": "opengl/include/GLES3",
      "into": "GLES3",
      "require": ["GLES3/gl3.h"]
    },
    {
      "source": "wilhelm",
      "find": "include/SLES",
      "into": "SLES",
      "require": ["SLES/OpenSLES.h", "SLES/OpenSLES_Android.h"]
    },
    {
      "source": "av",
      "find": "include/aaudio",
      "into": "aaudio",
      "require": ["aaudio/AAudio.h"]
    }
  ],
  "stubs": [
    {
      "library": "c",
      "source": "bionic",
      "file": "libc.map.txt",
      "verify": ["malloc", "free", "pthread_create", "openat"]
    },
    {
      "library": "m",
      "source": "bionic",
      "file": "libm.map.txt",
      "verify": ["sqrt", "fmod"]
    },
    {
      "library": "dl",
      "source": "bionic",
      "file": "libdl.map.txt",
      "verify": ["dlopen", "dlsym"]
    },
    {
      "library": "log",
      "source": "logging",
      "file": "liblog.map.txt",
      "verify": ["__android_log_write", "__android_log_print"]
    },
    {
      "library": "android",
      "source": ["base", "native"],
      "file": "libandroid.map.txt",
      "verify": ["AAssetManager_open", "ALooper_wake", "ANativeActivity_showSoftInput"]
    },
    {
      "library": "nativewindow",
      "source": "native",
      "file": "libnativewindow.map.txt",
      "verify": ["ANativeWindow_setBuffersTransform", "ANativeWindow_setBuffersGeometry"]
    },
    {
      "library": "EGL",
      "source": "native",
      "file": "libEGL.map.txt",
      "verify": ["eglCreateWindowSurface", "eglSwapBuffers", "eglQuerySurface"]
    },
    {
      "library": "GLESv2",
      "source": "native",
      "file": "libGLESv2.map.txt",
      "verify": ["glDrawArrays", "glTexImage2D"]
    },
    {
      "library": "GLESv3",
      "source": "native",
      "file": "libGLESv3.map.txt",
      "verify": ["glMapBufferRange"]
    },
    {
      "library": "aaudio",
      "source": "av",
      "file": "libaaudio.map.txt",
      "verify": ["AAudio_createStreamBuilder"]
    },
    {
      "library": "OpenSLES",
      "source": "wilhelm",
      "file": "libOpenSLES.map.txt",
      "verify": ["slCreateEngine"]
    }
  ]
}
